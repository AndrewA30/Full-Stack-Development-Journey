@page "/registration-confirmation/{EventId:int}"
@using EventEaseApp.Models
@inject NavigationManager NavigationManager

<PageTitle>Registration Confirmed - EventEase</PageTitle>

<div class="confirmation-container">
    <div class="confirmation-content">
        <div class="success-icon">✓</div>
        
        <h1>Registration Confirmed!</h1>
        <p class="confirmation-message">Thank you for registering for this event. A confirmation email has been sent to <strong>@userEmail</strong></p>

        <div class="confirmation-details">
            <h2>Registration Details</h2>
            
            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Attendee Name</span>
                    <span class="detail-value">@userFullName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Event</span>
                    <span class="detail-value">@eventName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Event Date</span>
                    <span class="detail-value">@eventDate</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Location</span>
                    <span class="detail-value">@eventLocation</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Registration Number</span>
                    <span class="detail-value">REG-@registrationNumber</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Status</span>
                    <span class="detail-value status-confirmed">Confirmed</span>
                </div>
            </div>
        </div>

        <div class="confirmation-info">
            <h3>What's Next?</h3>
            <ul>
                <li>Check your email for a confirmation with event details and calendar invite</li>
                <li>Arrive 15 minutes early on the day of the event</li>
                <li>Bring a valid ID if required</li>
                <li>Visit our website for any last-minute updates</li>
            </ul>
        </div>

        <div class="action-buttons">
            <button class="btn-primary" @onclick="BackToHome">Return to Home</button>
            <button class="btn-secondary" @onclick="BrowseMoreEvents">Browse More Events</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    [SupplyParameterFromQuery]
    public string? FirstName { get; set; }

    [SupplyParameterFromQuery]
    public string? LastName { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string userFullName = "";
    private string userEmail = "";
    private string eventName = "";
    private string eventDate = "";
    private string eventLocation = "";
    private string registrationNumber = "";

    protected override void OnInitialized()
    {
        userFullName = $"{FirstName} {LastName}";
        userEmail = Email ?? "your.email@company.com";
        registrationNumber = GenerateRegistrationNumber();

        // Get event details from mock data
        var events = new List<Event>
        {
            new Event
            {
                Id = 1,
                Name = "Annual Team Building Retreat",
                Date = new DateTime(2026, 2, 15),
                Location = "Mountain Resort, Colorado"
            },
            new Event
            {
                Id = 2,
                Name = "Tech Conference 2026",
                Date = new DateTime(2026, 3, 10),
                Location = "Convention Center, San Francisco"
            },
            new Event
            {
                Id = 3,
                Name = "Networking Gala Evening",
                Date = new DateTime(2026, 2, 28),
                Location = "Grand Ballroom, New York"
            },
            new Event
            {
                Id = 4,
                Name = "Workshop: Advanced C# Development",
                Date = new DateTime(2026, 2, 20),
                Location = "Tech Hub, Seattle"
            }
        };

        var selectedEvent = events.FirstOrDefault(e => e.Id == EventId);
        if (selectedEvent != null)
        {
            eventName = selectedEvent.Name;
            eventDate = selectedEvent.Date.ToString("MMMM dd, yyyy");
            eventLocation = selectedEvent.Location;
        }
    }

    private string GenerateRegistrationNumber()
    {
        return (EventId * 1000 + new Random().Next(1000)).ToString();
    }

    private void BackToHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private void BrowseMoreEvents()
    {
        NavigationManager.NavigateTo("/events");
    }
}
