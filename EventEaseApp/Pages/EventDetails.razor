@page "/event-details/{EventId:int}"
@using EventEaseApp.Models
@inject NavigationManager NavigationManager

<PageTitle>@(eventDetail?.Name ?? "Event Details") - EventEase</PageTitle>

<div class="event-details-container">
    @if (eventDetail != null)
    {
        <button class="btn-back" @onclick="GoBack">← Back to Events</button>

        <div class="event-details-header">
            <img src="@eventDetail.ImageUrl" alt="@eventDetail.Name" class="event-hero-image" />
            <div class="event-header-overlay">
                <span class="category-badge">@eventDetail.Category</span>
            </div>
        </div>

        <div class="event-details-content">
            <div class="main-content">
                <h1>@eventDetail.Name</h1>
                <p class="event-subtitle">@eventDetail.Description</p>

                <div class="event-info-grid">
                    <div class="info-item">
                        <span class="info-label">📅 Date</span>
                        <span class="info-value">@eventDetail.Date.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">🕐 Time</span>
                        <span class="info-value">@eventDetail.Date.ToString("hh:mm tt")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">📍 Location</span>
                        <span class="info-value">@eventDetail.Location</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">👥 Attendees</span>
                        <span class="info-value">@eventDetail.RegisteredAttendees / @eventDetail.Capacity</span>
                    </div>
                </div>

                <div class="description-section">
                    <h2>About This Event</h2>
                    <p>@eventDetail.Description</p>
                    <p>Join us for an amazing experience! This @eventDetail.Category.ToLower() event will feature networking opportunities, valuable insights, and memorable moments.</p>
                </div>
            </div>

            <div class="sidebar">
                <div class="registration-card">
                    <h3>Registration</h3>
                    <div class="available-spots">
                        <p>Available Spots: <strong>@(eventDetail.Capacity - eventDetail.RegisteredAttendees)</strong></p>
                    </div>
                    @if (eventDetail.Capacity - eventDetail.RegisteredAttendees > 0)
                    {
                        <button class="btn-register" @onclick="HandleRegisterClick">Register Now</button>
                    }
                    else
                    {
                        <button class="btn-register" disabled>Event Full</button>
                    }
                    <button class="btn-share">Share Event</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <p>Loading event details...</p>
    }
</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? eventDetail;

    protected override void OnInitialized()
    {
        // Simulated data - in a real application, this would come from an API
        var allEvents = new List<Event>
        {
            new Event
            {
                Id = 1,
                Name = "Annual Team Building Retreat",
                Description = "Join us for a day of fun activities and team bonding.",
                Date = new DateTime(2026, 2, 15, 9, 0, 0),
                Location = "Mountain Resort, Colorado",
                Category = "Corporate",
                Capacity = 100,
                RegisteredAttendees = 75,
                ImageUrl = "https://via.placeholder.com/800x300/667eea/ffffff?text=Team+Building"
            },
            new Event
            {
                Id = 2,
                Name = "Tech Conference 2026",
                Description = "Latest trends in technology and innovation.",
                Date = new DateTime(2026, 3, 10, 10, 0, 0),
                Location = "Convention Center, San Francisco",
                Category = "Technology",
                Capacity = 500,
                RegisteredAttendees = 450,
                ImageUrl = "https://via.placeholder.com/800x300/764ba2/ffffff?text=Tech+Conference"
            },
            new Event
            {
                Id = 3,
                Name = "Networking Gala Evening",
                Description = "An elegant evening to network with industry professionals.",
                Date = new DateTime(2026, 2, 28, 18, 0, 0),
                Location = "Grand Ballroom, New York",
                Category = "Networking",
                Capacity = 200,
                RegisteredAttendees = 120,
                ImageUrl = "https://via.placeholder.com/800x300/f093fb/ffffff?text=Gala+Evening"
            },
            new Event
            {
                Id = 4,
                Name = "Workshop: Advanced C# Development",
                Description = "Deep dive into advanced C# concepts and best practices.",
